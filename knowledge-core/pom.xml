<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Pinned to a released sequeless-build-parent (spec 1). Renovate bumps it. -->
  <parent>
    <groupId>org.sequeless</groupId>
    <artifactId>sequeless-build-parent</artifactId>
    <version>0.1.3</version>
    <relativePath/>
  </parent>

  <groupId>org.sequeless</groupId>
  <artifactId>knowledge-core</artifactId>
  <version>0.1.0</version>
  <name>knowledge-core</name>
  <description>Knowledge core: the AnswerQuestion use case, the inference port, and the prompt and citation rules.</description>

  <properties>
    <!-- Opts in to the parent's enforcer ban on Spring, Jena and Lombok (spec 1, section 5). -->
    <sequeless.enforcer.core.skip>false</sequeless.enforcer.core.skip>
    <!-- Deploy namespace (spec 19, section 6). Without it the parent deploys to sequeless-build and gets a 403. -->
    <sequeless.github.repository>sequeless-knowledge</sequeless.github.repository>
    <assertj.version>3.27.7</assertj.version>
    <junit.version>6.1.3</junit.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Spec 1: library repos import junit-bom in their own POM. The parent does not manage JUnit. -->
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Released versions, pinned here because a library does not import sequeless-bom (the BOM says so). -->
      <dependency>
        <groupId>org.sequeless</groupId>
        <artifactId>kernel-identity</artifactId>
        <version>0.1.1</version>
      </dependency>
      <dependency>
        <groupId>org.sequeless</groupId>
        <artifactId>kernel-values</artifactId>
        <version>0.1.1</version>
      </dependency>
      <dependency>
        <groupId>org.sequeless</groupId>
        <artifactId>schema-contract</artifactId>
        <version>0.2.0</version>
      </dependency>
      <dependency>
        <groupId>org.sequeless</groupId>
        <artifactId>query-core</artifactId>
        <version>0.2.1</version>
      </dependency>
      <dependency>
        <groupId>org.sequeless</groupId>
        <artifactId>query-field</artifactId>
        <version>0.1.1</version>
      </dependency>
      <dependency>
        <groupId>org.sequeless</groupId>
        <artifactId>query-testkit</artifactId>
        <version>0.2.1</version>
      </dependency>
      <dependency>
        <groupId>org.sequeless</groupId>
        <artifactId>query-field-testfixtures</artifactId>
        <version>0.2.0</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>kernel-identity</artifactId>
    </dependency>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>kernel-values</artifactId>
    </dependency>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>schema-contract</artifactId>
    </dependency>
    <!-- The Query side's host-facing service (QueryService) and its request types. -->
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>query-core</artifactId>
    </dependency>
    <!-- Declared directly: FieldScopeRequest, ClassRef, VersionPolicy and TraversalConfig are its api types (spec 19, section 5). -->
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>query-field</artifactId>
    </dependency>

    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>query-testkit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>query-field-testfixtures</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The tests import org.junit.jupiter.api directly, so it is declared as well. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The parent manages the archunit versions. The boundary test imports archunit and archunit-junit5-api, so they stay declared. -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5-api</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <repositories>
    <repository>
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
      <id>github</id>
      <url>https://maven.pkg.github.com/sequeless/*</url>
    </repository>
  </repositories>
</project>
